{
  "name": "@local/retro-dock",
  "version": "1.7.0",
  "private": true,
  "type": "module",
  "description": "A live speed meter for the DeepSeek Harness composer: tokens/sec on a real needle dial, context pressure and cache hit, with the last turn's average held when idle. Classic, VU, chart and Swiss looks.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test",
    "preview": "node scripts/gallery.mjs",
    "shots": "node scripts/shots.mjs",
    "catalogue": "node scripts/catalogue.mjs",
    "catalogue:shots": "node scripts/catalogue-shot.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "MEASUREMENT.md",
    "docs/classic-*.jpg",
    "docs/settings-*.jpg",
    "docs/seven-designs.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.1 <0.3.0-0",
      "dshReleases": {
        "0.2.0-rc.1": "compatible",
        "0.2.0-rc.2": "compatible",
        "0.2.1-rc.1": "compatible",
        "0.2.1-rc.2": "compatible",
        "0.2.1-rc.3": "compatible"
      }
    }
  },
  "dshhub": {
    "schemaVersion": 1,
    "displayName": "Retro Dock — Composer Instrument Dials",
    "summary": "See how fast DeepSeek is writing, right above the composer: a needle dial for tokens per second (calibrated against host stats), context pressure with a redline, cache hit, and the last turn's average held when idle. Four looks: classic, broadcast VU, chart, Swiss.",
    "categories": [
      "Web UI",
      "观测"
    ],
    "surfaces": [
      "web"
    ],
    "capabilities": {
      "provides": []
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.1 <0.3.0-0",
      "node": ">=20"
    },
    "permissions": {
      "network": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usermbzlj/dsh-retro-dock.git"
  },
  "homepage": "https://github.com/usermbzlj/dsh-retro-dock#readme",
  "bugs": {
    "url": "https://github.com/usermbzlj/dsh-retro-dock/issues"
  },
  "author": "usermbzlj",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "instrument",
    "gauge",
    "tokens-per-second",
    "theme",
    "retro"
  ],
  "devDependencies": {
    "esbuild": "^0.25.12",
    "jsdom": "^26.1.0",
    "playwright": "^1.64.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
